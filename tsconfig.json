{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": "./src",
    /* Aliases must be declared in BOTH places: tsconfig (so TS understands them)
       and babel.config.js (so Metro can bundle them at runtime). Forgetting either
       one gives a "module not found" error at runtime while the IDE stays green. */
    "paths": {
      "@app/*":      ["app/*"],
      "@core/*":     ["core/*"],
      "@shared/*":   ["shared/*"],
      "@features/*": ["features/*"]
    }
  },
  "include": ["src/**/*", "index.js"],
  "exclude": ["node_modules", "android", "ios"]
}
